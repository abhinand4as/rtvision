{#- Template for app.ini (read by the perceptra binary). Rendered by gen_configs.py. #}
# Generated by perceptra-run. Do not edit: change perceptra.yaml / model.yaml instead.

[service]
name={{ service_name }}
max_streams={{ max_streams }}

[model]
name={{ model.name }}
version={{ model.version }}
task={{ model.task }}
family={{ family }}
license={{ license }}
precision={{ precision }}

[inference]
hot_swap_file={{ hot_swap_file }}

[publish]
backend={{ pub.backend }}
interval_frames={{ pub.interval_frames }}
include_empty_frames={{ b(pub.include_empty_frames) }}
include_embeddings={{ b(pub.include_embeddings) }}
queue_max_events={{ queue.max_events }}
on_full={{ queue.on_full }}
shutdown_flush_timeout_ms={{ queue.shutdown_flush_timeout_ms }}
kafka_brokers={{ kafka.brokers | default("") if pub.backend == "kafka" else "" }}
kafka_topic={{ topic }}
kafka_key={{ kafka.key | default("sensor_id") }}
kafka_properties_file={{ kafka_props_path }}
file_path={{ file_path if pub.backend == "file" else "" }}

[timestamps]
source={{ ts.source }}

[tracker]
reid={{ b(tracker.reid) }}
reid_store_age={{ tracker.reid_store_age }}

[ops]
port={{ obs.ops_port }}
perf_interval_s={{ obs.perf_interval_s }}
log_level={{ obs.log_level }}
