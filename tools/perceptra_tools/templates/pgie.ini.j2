{#- Template for pgie.ini (nvinfer config). Rendered by gen_configs.py. #}
# Generated by perceptra-run. Do not edit: change model.yaml / perceptra.yaml instead.
# model={{ model.name }} version={{ model.version }} family={{ model.output.family }} precision={{ precision }}

[property]
gpu-id={{ s.gpu_id }}
onnx-file={{ onnx_file }}
model-engine-file={{ engine_file }}
labelfile-path={{ labels_file }}
{% if calib_file %}
int8-calib-file={{ calib_file }}
{% endif %}
batch-size={{ batch }}
network-mode={{ network_mode }}
network-type=0
process-mode=1
gie-unique-id=1
num-detected-classes={{ num_classes }}
net-scale-factor={{ scale }}
offsets={{ offsets }}
model-color-format={{ color_format }}
maintain-aspect-ratio={{ maintain_aspect_ratio }}
symmetric-padding={{ symmetric_padding }}
parse-bbox-func-name={{ parse_func }}
custom-lib-path={{ parser_lib }}
cluster-mode={{ cluster_mode }}
{% if filter_out %}
filter-out-class-ids={{ filter_out }}
{% endif %}

[class-attrs-all]
pre-cluster-threshold={{ num(classes.thresholds.default) }}
topk={{ classes.topk }}
{% if nms %}
nms-iou-threshold={{ num(classes.nms_iou) }}
{% endif %}
{% for cid, thr in per_class_thr.items() %}

[class-attrs-{{ cid }}]
pre-cluster-threshold={{ num(thr) }}
{% if nms %}
nms-iou-threshold={{ num(classes.nms_iou) }}
{% endif %}
{% endfor %}
