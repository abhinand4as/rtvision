{#- Template for ds-main.ini (deepstream-app main config). Rendered by gen_configs.py. #}
# Generated by perceptra-run. Do not edit: change perceptra.yaml / model.yaml instead.
# service={{ s.name }} model={{ model.name }} version={{ model.version }}

[application]
enable-perf-measurement=1
perf-measurement-interval-sec={{ obs.perf_interval_s }}

[tiled-display]
enable={{ b(visual) }}
rows={{ rows }}
columns={{ cols }}
width=1280
height=720
gpu-id={{ s.gpu_id }}
nvbuf-memory-type=0

# Streams are added/removed at runtime through the nvmultiurisrcbin REST API.
[source-list]
num-source-bins=0
list=
use-nvmultiurisrcbin=1
stream-name-display=1
max-batch-size={{ batch }}
http-ip={{ s.http_ip }}
http-port={{ s.rest_port }}

# Attributes of every source added over REST.
[source-attr-all]
enable=1
type=3
num-sources=1
gpu-id={{ s.gpu_id }}
cudadec-memtype=0
latency={{ src.latency_ms }}
rtsp-reconnect-interval-sec={{ src.rtsp_reconnect_interval_s }}
init-rtsp-reconnect-interval-sec={{ src.rtsp_reconnect_interval_s }}
rtsp-reconnect-attempts={{ src.rtsp_reconnect_attempts }}
drop-on-latency={{ b(src.drop_on_latency) }}
{% if src.force_tcp %}
select-rtp-protocol=4
{% endif %}

[streammux]
gpu-id={{ s.gpu_id }}
batch-size={{ batch }}
batched-push-timeout={{ mux.batched_push_timeout_us }}
width={{ mux.width }}
height={{ mux.height }}
enable-padding=0
nvbuf-memory-type=0
drop-pipeline-eos=1
live-source={{ b(mux.live_source) }}

[primary-gie]
enable=1
gpu-id={{ s.gpu_id }}
batch-size={{ batch }}
interval={{ interval }}
gie-unique-id=1
nvbuf-memory-type=0
config-file={{ pgie_config }}

[tracker]
{% if tracker_file %}
enable=1
tracker-width={{ tracker.width }}
tracker-height={{ tracker.height }}
gpu-id={{ s.gpu_id }}
ll-lib-file={{ ds_root }}/lib/libnvds_nvmultiobjecttracker.so
ll-config-file={{ tracker_file }}
{% else %}
enable=0
{% endif %}

[osd]
enable={{ b(visual) }}
gpu-id={{ s.gpu_id }}
border-width=2
text-size=12
text-color=1;1;1;1;
text-bg-color=0.3;0.3;0.3;1
font=Serif
display-text=1
nvbuf-memory-type=0

# Headless sink (events are published by perceptra itself).
[sink0]
enable=1
type=1
sync=0
gpu-id={{ s.gpu_id }}
nvbuf-memory-type=0
{% if outputs.display %}

[sink1]
enable=1
type=2
sync=0
gpu-id={{ s.gpu_id }}
nvbuf-memory-type=0
{% endif %}
{% if outputs.file %}

[sink2]
enable=1
type=3
container=1
codec=1
enc-type=0
sync=0
bitrate=4000000
output-file={{ outputs.file }}
gpu-id={{ s.gpu_id }}
nvbuf-memory-type=0
{% endif %}
{% if outputs.rtsp %}

[sink3]
enable=1
type=4
codec=1
enc-type=0
sync=0
bitrate=4000000
rtsp-port={{ outputs.rtsp.port | default(8554) }}
udp-port={{ outputs.rtsp.udp_port | default(5400) }}
gpu-id={{ s.gpu_id }}
nvbuf-memory-type=0
{% endif %}

[tests]
file-loop=0
