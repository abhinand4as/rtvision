{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/perceptra/model.schema.json",
  "title": "Perceptra model description",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "task", "license", "files", "input", "output", "precision"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "version": { "type": "string", "minLength": 1 },
    "task": { "enum": ["detect", "segment", "pose"] },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "source": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onnx", "labels"],
      "properties": {
        "onnx": { "type": ["string", "null"] },
        "labels": { "type": "string" },
        "engine": { "type": ["string", "null"] },
        "int8_calibration": { "type": ["string", "null"] },
        "nvinfer_config": { "type": ["string", "null"], "description": "Escape hatch: absolute path to an existing nvinfer config (e.g. in-container samples). When set, input/output are informational only." }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 16 },
        "height": { "type": "integer", "minimum": 16 },
        "channels": { "enum": [1, 3], "default": 3 },
        "color": { "enum": ["RGB", "BGR", "GRAY"], "default": "RGB" },
        "scale": { "type": "number", "exclusiveMinimum": 0, "default": 0.0039215697906911373 },
        "mean": { "type": "array", "items": { "type": "number" }, "minItems": 1, "maxItems": 3, "default": [0, 0, 0] },
        "resize": { "enum": ["letterbox_center", "letterbox_topleft", "stretch"], "default": "letterbox_center" },
        "dynamic_batch": { "type": "boolean", "default": true }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "num_classes"],
      "properties": {
        "family": { "enum": ["yolo_e2e", "yolo_raw", "detr", "efficient_nms", "builtin"] },
        "layers": { "type": "array", "items": { "type": "string" } },
        "box_format": { "enum": ["xyxy_px", "xyxy_norm", "cxcywh_px", "cxcywh_norm"] },
        "activation": { "enum": ["none", "sigmoid", "softmax"] },
        "has_background_class": { "type": "boolean", "default": false },
        "num_classes": { "type": "integer", "minimum": 1 }
      }
    },
    "classes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keep": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.35 },
            "per_class": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
          }
        },
        "nms_iou": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.45 },
        "topk": { "type": "integer", "minimum": 1, "default": 300 }
      }
    },
    "precision": { "enum": ["fp32", "fp16", "int8"] },
    "messaging": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "topic": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{1,249}$" } }
    }
  },
  "allOf": [
    { "if": { "properties": { "files": { "properties": { "nvinfer_config": { "type": "null" } } } } },
      "then": { "properties": { "files": { "required": ["onnx"] } } } }
  ]
}
