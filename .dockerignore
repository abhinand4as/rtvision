# Keep the build context small and free of weights/media (see docs/LICENSING.md).
# Patterns are rooted at the context: `**/` is needed to match in subdirectories.
.git
.github
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
build
**/build
output
generated
deploy/compose/.env
**/*.pt
**/*.pth
**/*.onnx
**/*.onnx.data
**/*.engine
**/*.plan
**/*.etlt
**/*.trt
**/*.safetensors
**/*.mp4
**/*.mkv
**/*.avi
**/*.h264
**/*.h265
**/*.o
**/*.so
**/*.a
