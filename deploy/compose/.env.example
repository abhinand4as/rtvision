# Copy to .env (gitignored). Knobs for deploy/compose and tests/integration.

# --- compose ---------------------------------------------------------------------------------
PERCEPTRA_IMAGE=perceptra:local
PERCEPTRA_MODEL=trafficcamnet-sample
# Address the published ports bind to (REST 9000 is unauthenticated; keep 127.0.0.1 unless the
# network is trusted).
PERCEPTRA_BIND=127.0.0.1
# Host directory mounted read-only at /opt/perceptra/models (relative to deploy/compose).
PERCEPTRA_HOST_MODELS_DIR=../../models/examples
PERCEPTRA_GPU=0
# SPDX id of a non-permissive model licence you accept, empty = none. Perceptra refuses to start
# a model whose licence is not on the permissive allow-list until you set this (docs/LICENSING.md).
# The default model (trafficcamnet-sample, NVIDIA's sample in the DeepStream image) needs:
#   PERCEPTRA_ACCEPT_MODEL_LICENSE=LicenseRef-NVIDIA-AI-Product-License
PERCEPTRA_ACCEPT_MODEL_LICENSE=

# --- tests/integration/run_all.sh ------------------------------------------------------------
MIN_EVENTS=3
STARTUP_TIMEOUT_S=600
CONSUME_TIMEOUT_S=90
