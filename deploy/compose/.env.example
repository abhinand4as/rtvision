# Copy to .env (gitignored). Knobs for deploy/compose and tests/integration.

# --- compose ---------------------------------------------------------------------------------
RTVISION_IMAGE=rtvision:local
# Default: RF-DETR Small (Apache-2.0). Export its ONNX once with tools/export/rfdetr/export.sh.
RTVISION_MODEL=rfdetr-s-coco
# Address the published ports bind to (REST 9000 is unauthenticated; keep 127.0.0.1 unless the
# network is trusted).
RTVISION_BIND=127.0.0.1
# Host directory mounted read-only at /opt/rtvision/models (relative to deploy/compose).
RTVISION_HOST_MODELS_DIR=../../models/examples
RTVISION_GPU=0
# SPDX id of a non-permissive model licence you accept, empty = none. RTVision refuses to start
# a model whose licence is not on the permissive allow-list until you set this (docs/LICENSING.md).
# Not needed for the default model. E.g. trafficcamnet-sample (NVIDIA's sample in the DeepStream
# image) needs LicenseRef-NVIDIA-AI-Product-License.
RTVISION_ACCEPT_MODEL_LICENSE=

# --- web UI + replicator (compose.ui.yaml) ------------------------------------------------------
RTVISION_UI_PORT=8080
REPLICATOR_PORT=8554
# Host names (besides localhost and IP addresses) the UI may be opened with, comma separated.
RTVISION_UI_ALLOWED_HOSTS=

# --- tests/integration/run_all.sh ------------------------------------------------------------
MIN_EVENTS=3
STARTUP_TIMEOUT_S=600
CONSUME_TIMEOUT_S=90
